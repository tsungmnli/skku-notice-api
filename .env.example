# Copy to .env for local development. Never commit .env.
APP_ENV=dev

# Browser origins allowed to call the API (comma-separated). Required in prod; '*' is rejected there.
# Dev: use `localhost`, not 127.0.0.1 -- the web app calls http://localhost:8000, and the session cookie
# only travels if web and API share one host name (see docs/api-contract.md).
CORS_ORIGINS=http://localhost:3000

# Required in prod. This matches compose.dev.yaml. `postgres://` is accepted as well.
DATABASE_URL=postgresql://skku:dev@127.0.0.1:5432/skku

# Required in prod only. Leave it UNSET in dev: it defaults to http://localhost:3000 (web, for the
# links in mails) and http://localhost:8000 (this API, for the Google callback). Setting it to the
# web URL in dev would send Google back to the Next.js server, which has no /api.
# PUBLIC_URL=https://skku.example.com

# Unset = on in dev, off in prod.
# DOCS_ENABLED=true

# Crawler (python -m app.crawl). Only DATABASE_URL is required; these are the defaults.
# CRAWL_MAX_PAGES=3          # list pages per run, 10 posts each (use --pages 50 for a first backfill)
# CRAWL_DELAY_SECONDS=1.0    # pause between requests to skku.edu
# CRAWL_DETAIL_LIMIT=30      # view pages read per run for notices whose title has no deadline (0 = off)
# CRAWL_DETAIL_MAX_AGE_DAYS=60  # only notices posted within this many days
# CRAWL_USER_AGENT=...

# Accounts (sign-up / login). In prod every value below except GOOGLE_* is required.
# Signs the OAuth state cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# SESSION_TTL_DAYS=30

# Resend SMTP. Without SMTP_HOST the dev server only logs the mail instead of sending it.
# (The link of every mail is printed in this server's console, so sign-up can be finished locally.)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_FROM=SKKU 공지 <noreply@skkunoti.tsungmn.com>

# Google sign-in (optional, set both). Redirect URI: <PUBLIC_URL>/api/v1/auth/google/callback
# (dev: http://localhost:8000/api/v1/auth/google/callback). Needs SESSION_SECRET.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile secret. Unset in dev = the check is skipped.
# To exercise the check locally, pair Cloudflare's test secret 1x0000000000000000000000000000000AA
# (always passes) with the web's test site key. A real secret needs the real site key on the web side.
# TURNSTILE_SECRET_KEY=

# Proxies in front of the app: Cloudflare + ingress = 2. Required in prod (0 is valid).
# TRUSTED_PROXY_HOPS=2
